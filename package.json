{
  "name": "double-pane",
  "private": true,
  "description": "Dual-pane desktop file manager (Wails v3 + Go + React)",
  "scripts": {
    "prepare": "husky",
    "precommit": "lint-staged",
    "check": "wails3 task check",
    "check:build": "wails3 task check:build",
    "knip": "npm run knip --prefix frontend"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0"
  },
  "lint-staged": {
    "*.go": "gofmt -w",
    "frontend/src/**/*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint --prefix frontend",
    "frontend/src/**/*.{ts,tsx,css,json}": "npm run format --prefix frontend"
  }
}
